{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Copy this file for an instance deployment and replace every placeholder
	// binding with resources from that operator's Cloudflare account.
	"name": "jaydslist-instance",
	"compatibility_date": "2026-05-07",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jaydslist-instance-d1",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "PHONE_VERIFICATION_KV",
			"id": "00000000000000000000000000000000"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"INSTANCE_THEME": "default",
		// Replace these non-secret placeholders with values for the operator's own instance.
		"INSTANCE_NAME": "Jaydslist",
		"INSTANCE_TAGLINE": "Real connections, real people",
		"INSTANCE_URL": "https://your-instance.example",
		"INSTANCE_LEGAL_EMAIL": "operator@your-instance.example",
		"INSTANCE_SOURCE_URL": "https://github.com/team-insatiable/jaydslist",
		"DBBL_API_URL": "https://api.dbblprotocol.org",
		"CF_IMAGES_ACCOUNT_ID": "YOUR_CLOUDFLARE_ACCOUNT_ID",
		"CF_IMAGES_ACCOUNT_HASH": "YOUR_IMAGES_DELIVERY_HASH",
		"VAPID_PUBLIC_KEY": "YOUR_VAPID_PUBLIC_KEY",
		"VAPID_CONTACT": "mailto:operator@your-instance.example"
	}
}
