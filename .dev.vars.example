# Copy to .dev.vars and fill in real values for local development.
# In CI, this file is copied as-is to .dev.vars so `wrangler types` generates
# the same Env interface (key names only matter for type generation, not values).
ENVIRONMENT=development
INSTANCE_THEME=default
INSTANCE_NAME=Jaydslist
INSTANCE_TAGLINE="Real connections, real people"
# Optional absolute HTTPS override for the default /email-logo.png asset.
INSTANCE_EMAIL_LOGO_URL=
INSTANCE_URL=http://localhost:5173
INSTANCE_LEGAL_EMAIL=operator@example.com
INSTANCE_SOURCE_URL=https://github.com/team-insatiable/jaydslist
INSTANCE_PRELAUNCH_MODE=false
BETTER_AUTH_SECRET=
ORIGIN=http://localhost:5173
# Optional cross-instance reputation lookups and ban reporting. Disabled by default.
DBBL_ENABLED=false
DBBL_API_URL=https://api.dbblprotocol.org
DBBL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_PEPPER=
CONTACT_ENCRYPTION_KEY=
DEV_BYPASS_OTP=
# Transactional email. Choose `resend` or `ses`.
EMAIL_PROVIDER=resend
EMAIL_FROM="Jaydslist <noreply@example.com>"
RESEND_API_KEY=
# Amazon SES (only required when EMAIL_PROVIDER=ses)
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-1
# SES_SESSION_TOKEN= # only for temporary AWS credentials
ADMIN_EMAILS=
# Cloudflare Images identifiers are non-secret instance configuration.
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_ACCOUNT_HASH=
CF_IMAGES_API_TOKEN=
# Optional private delivery; requires the jaydslistPrivateOriginal variant (see photo-screening.md).
CF_IMAGES_SIGNING_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=mailto:operator@example.com
VAPID_PRIVATE_KEY=

# Amazon Rekognition image screening (separate IAM credentials from SES)
REKOGNITION_ACCESS_KEY_ID=
REKOGNITION_SECRET_ACCESS_KEY=
REKOGNITION_REGION=us-east-1
# REKOGNITION_SESSION_TOKEN= # only for temporary AWS credentials
